# Server
PORT=3000
# Set this before exposing the app. Send it as the x-admin-token header from the UI.
APP_ADMIN_TOKEN=

# OpenAI (server-side only; never expose this in the browser)
OPENAI_API_KEY=
OPENAI_GPT_MODEL=gpt-5
# Select an executor-capable model available to your OpenAI project.
OPENAI_CODEX_MODEL=gpt-5.4

# Campaign safety controls. Live mode is deliberately off by default.
ENABLE_LIVE_CONNECTORS=false
MAX_DAILY_BUDGET=100

# Add provider credentials as environment variables. The UI stores only their names,
# for example MARKETING_META_TOKEN—not token values.
MARKETING_META_TOKEN=
MARKETING_GOOGLE_TOKEN=
MARKETING_LINKEDIN_TOKEN=
